<?xml version="1.0"?>
<Container version="2">
  <Name>SonicHorizon</Name>
  <Repository>ghcr.io/adman1020/sonic-horizon:latest</Repository>
  <Registry>https://github.com/Adman1020/Sonic-Horizon/pkgs/container/sonic-horizon</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Adman1020/Sonic-Horizon/issues</Support>
  <Project>https://github.com/Adman1020/Sonic-Horizon</Project>
  <Overview>Sonic Horizon is a lightweight, self-hosted single-page web application designed to generate deep, unbiased, and highly tailored music discovery playlists using Large Language Models (LLMs).</Overview>
  <Category>MediaApp:Music</Category>
  <WebUI>http://[IP]:[PORT:8080]</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/Adman1020/Sonic-Horizon/main/public/icon.png</Icon>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="The port the WebUI runs on." Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="App Data" Target="/config" Default="/mnt/user/appdata/sonichorizon" Mode="rw" Description="Container AppData (Database &amp; encrypted settings)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/sonichorizon</Config>
  <Config Name="Uploads Data" Target="/data/uploads" Default="/mnt/user/appdata/sonichorizon/uploads" Mode="rw" Description="Storage for user uploaded JSON/CSV files" Type="Path" Display="advanced" Required="false" Mask="false">/mnt/user/appdata/sonichorizon/uploads</Config>
  <Config Name="Timezone" Target="TZ" Default="Europe/London" Mode="" Description="Container Timezone" Type="Variable" Display="always" Required="false" Mask="false">Europe/London</Config>
</Container>
