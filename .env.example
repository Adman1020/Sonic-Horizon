# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# Generate the two secrets with:
#   openssl rand -hex 32
#
# APP_BASE_URL is the public address users reach the app at (no trailing
# slash), e.g. https://sonic-horizon.mydomain.com. It is used to build the
# Spotify OAuth redirect URI, so it must match the Redirect URI registered in
# your Spotify Dashboard: <APP_BASE_URL>/api/spotify/callback
#
# SPOTIFY_CLIENT_ID / SPOTIFY_CLIENT_SECRET come from your Spotify Developer
# Dashboard app. Spotify OAuth is the app's login method, so the container
# will refuse to start without them.
#
# TZ is optional (defaults to UTC) and controls when Scheduled Refreshes fire.
#
# The AI provider, model and API key are NOT environment variables anymore.
# Sign in as an admin and set them once in the Admin panel (Admin → AI
# Configuration) — every user shares that configuration. The key is stored
# encrypted in the database.

JWT_SECRET=
ENCRYPTION_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APP_BASE_URL=
# TZ=Europe/London
