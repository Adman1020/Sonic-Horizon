# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# Generate the two secrets with:
#   openssl rand -hex 32
#
# docker compose will refuse to start without JWT_SECRET and ENCRYPTION_SECRET set.

JWT_SECRET=
ENCRYPTION_SECRET=

# --- Optional integrations (can also be entered per-user in the app UI) ---

# Spotify app: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the redirect URI registered in your Spotify dashboard
SPOTIFY_REDIRECT_URI=http://localhost:8080/api/spotify/callback

# Last.fm API key: https://www.last.fm/api/account/create
LASTFM_API_KEY=
