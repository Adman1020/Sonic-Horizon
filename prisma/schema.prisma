// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Identity is the Spotify account itself — "Continue with Spotify" is the only
// login path. First sign-in bootstraps the admin; later sign-ins from unknown
// Spotify IDs land in a Pending state until an admin approves them.
model User {
  id              String        @id @default(uuid())
  spotifyId       String?       @unique
  spotifyUsername String?
  spotifyEmail    String?
  isAdmin         Boolean       @default(false)
  approved        Boolean       @default(false)
  tokenVersion    Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  knownArtists    KnownArtist[]
  settings        Settings?
}

// Single-row global config (id = "global"). Holds the AI provider/model/key
// that an admin configures in the Admin panel — all users share it. The API
// key is encrypted with lib/encrypt (same scheme the old per-user keys used).
model AppConfig {
  id         String   @id
  aiProvider String?
  aiModel    String?
  aiKeyData  String? // Encrypted key string (Ollama stores its base URL here)
  rpm        Int      @default(5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model KnownArtist {
  id           String    @id @default(uuid())
  artistName   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt      DateTime  @default(now())
  signals      String    @default("{}")
  lastSeenAt   DateTime?
  lastPlayedAt DateTime? // Most recent listen (from user-read-recently-played) — exclusion only, never a seed

  @@unique([userId, artistName])
}

model Settings {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spotifyAccessToken    String?
  spotifyRefreshToken   String?
  theme                 String   @default("analog-hifi")
  obscurityLevel        Int      @default(3)
  outputFormat          String   @default("tracks")
  recommendationLimit   Int      @default(20)
  requestsPerMinute     Int      @default(5)
  spotifyPlaylistPublic Boolean  @default(true)
  spotifySources        String   @default("all")
  tasteFocus            String   @default("automatic")
  genres                String   @default("[]")
  discoveryMode         String   @default("deep-roots")
  rabbitHoleArtist      String?
  preferredProvider     String?
  preferredModel        String?
  scheduleEnabled       Boolean  @default(false)
  scheduleInterval      String   @default("daily")
  scheduleHour          Int      @default(8)
  scheduleDay           Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
